		# ------------------------------------------------------------------
		#  新增格子按钮「+」（右键 = 折叠/展开整条信息条，Shift+右键 = 复位）
		#  外观 = 和数据格一样的 96x26 原版框，位置 = 第 2 行最左格（第 8 格）的位置
		# ------------------------------------------------------------------
		containerWindowType = {
			name = "dui_add_wrap"
			position = { x = -680 y = 43 }	# LAYOUT
			size = { width = 96 height = 26 }
			Orientation = UPPER_RIGHT
			clipping = no

