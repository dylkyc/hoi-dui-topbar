# ============================================================================
#  DUI Dynamic Topbar HUD  --  界面布局（2026-10-03 实测修正版）
#  ---------------------------------------------------------------------------
#  8 个可自定义的数据格，全部住在原版顶栏内部；点击格子弹出指标选择菜单。
#
#  ★ 锚点语义（踩过坑，务必记住）：
#    Orientation = UPPER_RIGHT 时，位置里的 x 是「元素**左边缘**距屏幕右边缘
#    的距离」，也就是 左边缘 = 屏幕宽度 + x。所以想让某个元素的**右边缘**落在
#    距右边 R 的位置，必须写 x = -(R + 元素宽度)。
#    （实测：单行 8 格方案里 x=-360 的格子实际出现在 1560~1656，而不是预想的
#      1464~1560；弹窗面板也整体跑到屏幕外——都是这个原因。）
#
#  ★ 尺寸对齐原版（实测原版顶栏数据框 DDS 尺寸）：
#       GFX_generic_box_smallest = 70x26   （政治点/稳定度/战争支持/工业/运输/燃料）
#       GFX_generic_box_small    = 88x26
#       GFX_generic_box_96       = 96x26   （人力框，本 mod 采用这个尺寸）
#       GFX_generic_box_125      = 124x26
#    本 mod 的格子尺寸 = 96x26，和原版人力框一模一样；底板也用同一个精灵
#    GFX_generic_box_96（之前用的 GFX_tiled_generic_bg_1 是原版"经验框"那种
#    29x29 平铺贴图，会被拉成 28 高、看起来比原版框更厚重）。
#
#  ★ 顶栏内的可用空档（1920 宽实测）：
#      第 1 行 y 5~31 ：原版数据框一直排到 x=1026（核弹框），所以 x≥1040 才安全
#      第 2 行 y 43~69：原版国策/情报按钮到 x≈1240；圆形警报组从 x≈1543 起
#      右侧边界：暂停键与日期面板从 x≈1545 起
#    → 第 1 行放 5 格（1040~1536），第 2 行放 3 格（1240~1536），8 格全在栏内。
#
#  ★「+」按钮放在第 2 行最左格的位置（= 第 8 格 dui_slot_7 的位置）：
#    第 8 格只在格子数 = 8 时显示，而「+」只在格子数 < 8 时显示，两者永不同时出现，
#    所以可以共用同一块位置，点了「+」之后新格子正好出现在同一个地方。
#
#  布局旋钮（LAYOUT）—— x 是「左边缘距屏幕右边的距离」，格子宽 96、间隔 100：
#    第 1 行 y = 5   槽位 0..4  x = -480, -580, -680, -780, -880
#    第 2 行 y = 43  槽位 5..7  x = -480, -580, -680
#    「+」按钮        x = -680  y = 43
#    选择菜单面板      x = -924  y = 80，size = 540 x 186（弹出窗口，不受"必须在顶栏内"限制）
#    菜单网格容器      x = -158 y = 54（= 12 - 170：抵消引擎"首个条目右移一个条目宽度"）
#    菜单条目          size = 170 x 26，图标 scale = 1
#
#  ★ 图标：所有指标都改用原版的小图标（18~27px：civ_factory / mil_factory /
#    nav_dockyard_texticon / fuel / victory_points / war_score …），并用 scale = 1
#    按原尺寸显示，这样和原版顶栏图标一样大。之前用的是 70x29 / 110x41 的宽条贴图，
#    会被放大到占满整个格子，格子里的字都被挤掉了。
# ============================================================================

guiTypes = {

	# ========================================================================
	#  根容器：铺满屏幕，无背景，作为脚本化 GUI 的挂载点
	#  （window_name = "dui_topbar_root"，parent_window_token = top_bar）
	# ========================================================================
	containerWindowType = {
		name = "dui_topbar_root"
		position = { x = 0 y = 0 }
		size = { width = 100%% height = 100%% }
		Orientation = UPPER_LEFT
		clipping = no
		moveable = no

		# ------------------------------------------------------------------
		#  第 1 行：槽位 0（最右）~ 槽位 4
		#  注意：buttonType 不能写 size（会报 "Malformed token: width/height"），
		#        按钮会自动铺满所在容器的尺寸，容器尺寸写在 containerWindowType 上。
		# ------------------------------------------------------------------
		containerWindowType = {
			name = "dui_slot_0"
			position = { x = -480 y = 5 }	# LAYOUT 第1行 第1格
			size = { width = 96 height = 26 }
			Orientation = UPPER_RIGHT
			clipping = no

			iconType = {
				name = "dui_slot_0_hl"
				spriteType = "GFX_execute_battle_plan_glow"
				position = { x = 0 y = -1 }
				alwaystransparent = yes
			}
			buttonType = {
				name = "dui_slot_0_btn"
				quadTextureSprite = "GFX_generic_box_96"
				position = { x = 0 y = 0 }
				clicksound = click_default
				oversound = ui_menu_over
			}
			iconType = {
				name = "dui_slot_0_icon"
				spriteType = "GFX_pol_power_icon"
				position = { x = 4 y = 1 }
				scale = 1
				alwaystransparent = yes
			}
			instantTextBoxType = {
				name = "dui_slot_0_text"
				position = { x = 27 y = 4 }
				font = "hoi_18mbs"
				text = "[GetDUISlot0Text]"
				maxWidth = 67
				maxHeight = 20
				format = right
				fixedsize = yes
				alwaystransparent = yes
			}
		}

		containerWindowType = {
			name = "dui_slot_1"
			position = { x = -580 y = 5 }	# LAYOUT 第1行 第2格
			size = { width = 96 height = 26 }
