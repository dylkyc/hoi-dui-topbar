	# ========================================================================
	#  顶层容器 2：指标选择面板（弹出窗口，位于顶栏下方）
	#  （脚本化 GUI 的 window_name 必须是「独立容器」，不能嵌套在别的容器里；
	#    整体显隐交给 scripted_gui 的 visible，所以这里直接用 background）
	#  条目尺寸参考黑冰的选择菜单：每条一个原版风格的方框 + 左侧小图标 + 左对齐文字
	# ========================================================================
	containerWindowType = {
		name = "dui_menu_panel"
		position = { x = -816 y = 80 }	# LAYOUT
		size = { width = 432 height = 260 }
		Orientation = UPPER_RIGHT
		clipping = no

		background = {
			name = "dui_menu_bg"
			quadTextureSprite = "GFX_tiled_window2_1b_border"
		}
			instantTextBoxType = {
				name = "dui_menu_header"
				position = { x = 12 y = 8 }
				font = "hoi_18mbs"
				text = "DUI_MENU_HEADER"
				maxWidth = 460
				maxHeight = 24
				format = left
				alwaystransparent = yes
			}
			# 新增格子按钮（原版提示会盖住顶栏里那个位置，所以挪进弹窗里）
			buttonType = {
				name = "dui_menu_add"
				quadTextureSprite = "GFX_generic_box_smallest"
				position = { x = 324 y = 6 }
				clicksound = click_ok
				oversound = ui_menu_over
				pdx_tooltip = "DUI_ADD_TT"
				pdx_tooltip_delayed = "DUI_ADD_TT_DELAYED"
			}
			instantTextBoxType = {
				name = "dui_menu_add_label"
				position = { x = 324 y = 9 }
				font = "hoi_16mbs"
				text = "DUI_MENU_ADD"
				maxWidth = 70
				maxHeight = 20
				format = centre
				alwaystransparent = yes
			}
			buttonType = {
				name = "dui_menu_close"
				quadTextureSprite = "GFX_closebutton"
				position = { x = 402 y = 6 }
				clicksound = click_close
				oversound = ui_menu_over
				pdx_tooltip = "CLOSE"
			}
			# 展开箭头（显示在第一个条目「装备库存」右侧）


			# 固定入口：点它展开 12 个装备大类（面板的直接子元素，永远可点）



			containerWindowType = {
				name = "dui_menu_grid_container"
				# 注意：动态列表的第 1 个条目会被放在「容器左边缘 + 一个格位宽度」的位置，
				# 所以这里先把 x 减去一个格位宽度（12 - 188 = -176）来抵消，
				# 条目才会正好从面板左边 12px 处开始排。
				position = { x = -124 y = 56 }	# LAYOUT
				size = { width = 408 height = 189 }
				clipping = no

				# 由脚本化 GUI 的 dynamic_lists 动态填充
				gridboxtype = {
					name = "dui_menu_grid"
					position = { x = 0 y = 0 }
					size = { width = 408 height = 189 }
					slotsize = { width = 136 height = 27 }
					max_slots_horizontal = 3
					max_slots_vertical = 7
				}
			}
		}

	# ========================================================================
	#  菜单条目模板：数组里每个可选指标都会实例化一份
	# ========================================================================
	containerWindowType = {
		name = "dui_menu_entry"
		position = { x = 0 y = 0 }
		size = { width = 124 height = 26 }

		# 按钮的精灵就是"盒子"本身，它的原始尺寸 124x26 正好等于条目尺寸，
		# 所以按钮会把图标和文字完整包在里面（之前用平铺贴图，按钮只画成贴图原始大小）。
		buttonType = {
			name = "dui_menu_item"
			quadTextureSprite = "GFX_generic_box_125"
			position = { x = 0 y = 0 }
			clicksound = click_default
			oversound = ui_menu_over
