				quadTextureSprite = "GFX_generic_box_96"
				position = { x = 0 y = 0 }
				clicksound = click_ok
				oversound = ui_menu_over
				pdx_tooltip = "DUI_ADD_TT"
				pdx_tooltip_delayed = "DUI_ADD_TT_DELAYED"
			}
			instantTextBoxType = {
