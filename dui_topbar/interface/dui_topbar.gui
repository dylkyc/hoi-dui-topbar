		containerWindowType = {
			name = "dui_slot_6"
			position = { x = -580 y = 43 }	# LAYOUT 第2行 第2格
			size = { width = 96 height = 26 }
			Orientation = UPPER_RIGHT
			clipping = no

			iconType = {
